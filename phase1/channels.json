{
  "streams": ["scratch", "meta"],
  "permissions": {
    "tools": {
      "save_skill": "ask",
      "update_skill": "ask"
    },
    "bash": {
      "rm -rf /*": "deny",
      "sudo *": "deny"
    },
    "paths": {
      "write": {
        "memory/*": "ask"
      },
      "edit": {
        "memory/*": "ask"
      }
    }
  },
  "channels": {
    "scratch": {},
    "meta": {
      "add": ["push_changes"],
      "push": true,
      "permissions": {
        "tools": {
          "push_changes": "ask"
        }
      }
    },
    "dm": {}
  },
  "people": {}
}
