# Credential proxy (Phase 2). Deployed as fa-proxy by docker-compose on the
# gateway box; keys live only in /opt/family-agent/proxy.env (mode 600),
# never in the gateway's .env and never in any exec container.
#
# Routes (prefix stripped, upstream path prepended):
#   /llm/*   -> https://openrouter.ai/api/v1/*   (LLM_BASE_URL=http://fa-proxy:8080/llm)
#   /kagi/*  -> https://kagi.com/api/v2/*        (search + summarize)
#   /brave/* -> https://api.search.brave.com/res/v1/* (web search)
# Callers send no Authorization header; the proxy replaces it upstream.
#
# Single-box note (deviation from phase2-hardening.md, 12 Nov): activated on
# the session box before the two-box split. The gateway process is trusted
# either way; the property that ships now is that key material stops living
# in the process environment of anything that talks to the untrusted half
# of the network, and Phase 3 open-world responses get a checkpoint here.
# Moving the proxy to a gateway box later changes one env var (the URL).
#
# Known exception (by design, see phase1/exec/mark): the mark sidecar token
# is not proxied — its viewer URL carries the token into conversations by
# design, so fronting only the registration call would change nothing.

{
	admin off
	auto_https off
}

:8080 {
	# LLM upstream. The gateway sends a placeholder key (or none); the
	# proxy's key wins upstream.
	handle_path /llm/* {
		rewrite * /api/v1{uri}
		reverse_proxy https://openrouter.ai {
			header_up Host openrouter.ai
			header_up Authorization "Bearer {env.OPENROUTER_API_KEY}"
			header_down -Server
		}
	}

	handle_path /kagi/* {
		rewrite * /api/v2{uri}
		reverse_proxy https://kagi.com {
			header_up Host kagi.com
			header_up Authorization "Bot {env.KAGI_API_KEY}"
			header_down -Server
		}
	}

	handle_path /brave/* {
		rewrite * /res/v1{uri}
		reverse_proxy https://api.search.brave.com {
			header_up Host api.search.brave.com
			header_up X-Subscription-Token {env.BRAVE_API_KEY}
			header_down -Server
		}
	}

	respond 404
}
