# Credential proxy (Phase 2), deployed as fa-proxy on the vault box — the
# trusted half of the two-box split. Keys live only in that box's
# /opt/family-agent/proxy.env (mode 600); the session box (10.0.0.3, the
# gateway and exec containers) holds no upstream credentials at all, so a
# full compromise of it reaches no key material. The port listens on the
# private network only; bootstrap.sh firewalls it to the session box.
#
# Routes (prefix stripped, upstream path prepended):
#   /llm/*   -> https://openrouter.ai/api/v1/*   (LLM_BASE_URL=http://10.0.0.4:8080/llm)
#   /kagi/*  -> https://kagi.com/api/v2/*        (search + summarize)
#   /brave/* -> https://api.search.brave.com/res/v1/* (web search)
# Callers send no Authorization header; the proxy replaces it upstream.
#
# Phase 3: open-world responses (fetch, email bodies) get their ingress
# scanning checkpoint here.
#
# Known exception (by design, see phase1/exec/mark): the mark sidecar token
# is not proxied — its viewer URL carries the token into conversations by
# design, so fronting only the registration call would change nothing.

{
	admin off
	auto_https off
}

:8080 {
	# LLM upstream. The gateway sends a placeholder key (or none); the
	# proxy's key wins upstream.
	handle_path /llm/* {
		rewrite * /api/v1{uri}
		reverse_proxy https://openrouter.ai {
			header_up Host openrouter.ai
			header_up Authorization "Bearer {env.OPENROUTER_API_KEY}"
			header_down -Server
		}
	}

	handle_path /kagi/* {
		rewrite * /api/v2{uri}
		reverse_proxy https://kagi.com {
			header_up Host kagi.com
			header_up Authorization "Bot {env.KAGI_API_KEY}"
			header_down -Server
		}
	}

	handle_path /brave/* {
		rewrite * /res/v1{uri}
		reverse_proxy https://api.search.brave.com {
			header_up Host api.search.brave.com
			header_up X-Subscription-Token {env.BRAVE_API_KEY}
			header_down -Server
		}
	}

	respond 404
}
